// 开始定义 TypeScript 配置文件
{
	// 继承 @vue/tsconfig 提供的 dom 相关配置
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	// 定义哪些文件需要被 TypeScript 编译器处理
	"include": ["src", "types/**/*.d.ts", "mock/**/*.ts"], // 指定一组要编译的文件及目录，包括src目录、types目录下的所有.d.ts文件和mock目录下的所有.ts文件
	// 要包含的类型声明文件名列表，这些类型声明会被编译器包含进来进行类型检查
	"types": [
		"@intlify/unplugin-vue-i18n/types", // Vue的国际化插件的类型声明
		"vite/client", // Vite客户端API的类型声明
		"element-plus/global", // Element Plus UI库的全局类型声明
		"@types/qrcode", // qrcode库的类型声明（如果是从npm安装的，则通常放在@types下）
		"vite-plugin-svg-icons/client" // Vite的SVG图标插件客户端API的类型声明
	],
	"exclude": [
		"src/**/__tests__/*" // 排除 src 目录下所有 __tests__ 子目录中的文件，通常用于忽略测试文件
	],
	// 定义 TypeScript 编译器的选项
	"compilerOptions": {
		"composite": true, // 启用项目引用和增量编译
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo", // 设置增量编译信息的存储位置
		"baseUrl": ".", // 设置解析非相对模块名的基准目录，'.' 表示当前目录即项目根目录
		"target": "esnext", // 设置ECMAScript目标版本为最新
		"useDefineForClassFields": true, // 使用新的类字段定义语法，而不是传统的构造函数赋值方式
		"module": "esnext", // 指定生成哪个模块系统代码，这里设置为最新的ES模块系统
		"moduleResolution": "node", // 决定如何处理模块，这里使用Node.js风格的模块解析机制
		"strict": true, // 启用所有严格的类型检查选项
		"jsx": "preserve", // 在.tsx文件里支持JSX，但不进行转换，保留原样
		"sourceMap": true, // 生成相应的.map文件，便于调试
		"resolveJsonModule": true, // 允许解析JSON模块
		"esModuleInterop": true, // 允许默认导入从CommonJS模块，改善与ES模块的互操作性
		"jsxImportSource": "vue", // 指定JSX导入源为vue，这是Vue 3中使用JSX的特定设置
		"lib": ["esnext", "dom"], // 编译过程中需要引入的库文件的列表，包括最新的ES特性和DOM API
		"allowJs": true, // 允许编译javascript文件，而不仅仅是TypeScript文件
		"forceConsistentCasingInFileNames": true, // 强制文件名大小写敏感，防止因大小写不一致导致的问题
		"allowSyntheticDefaultImports": true, // 允许无副作用的默认导入，即使模块没有默认导出也可以这样导入
		"strictFunctionTypes": false, // 禁用函数类型参数与返回类型的严格检查，增加灵活性
		"noUnusedLocals": true, // 报告未使用的本地变量，帮助保持代码的整洁性
		"noUnusedParameters": true, // 报告未使用的函数参数，同样有助于保持代码的整洁性
		"experimentalDecorators": true, // 启用实验性的ES装饰器支持，这是一种用于修改类和类成员行为的特殊声明
		"noImplicitAny": false, // 允许在表达式和声明上有隐式的'any'类型，不进行严格的类型推断
		"skipLibCheck": true, // 跳过所有声明文件的类型检查，提高编译速度
		// 定义模块路径别名，便于在项目中更简洁地引用模块
		"paths": {
			"@/*": ["./src/*"] // 将 '@/' 别名映射到 'src/' 目录，便于在项目中直接通过 '@/模块路径' 的方式引用 src 目录下的模块
		}
	}
}
