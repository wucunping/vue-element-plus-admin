/**
 * @file settings.json
 * @description 设置文件包含项目的各种配置信息
 * @example {
 *   "typescript.tsdk": "...",
 *   "prettier.enable": true,
 *   ...
 * }
 * @version 1.0.0
 * @author [吴尘](https://github.com/wucunping)
 * @date 2024-11-18
 * @module settings
 */
{
  // TypeScript SDK 的路径
  "typescript.tsdk": "node_modules/typescript/lib",

  // 启用 Prettier 格式化
  "prettier.enable": true,

  // 保存时自动执行的代码操作
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit" // 具体的操作为修复所有 eslint 报告的问题
  },

  // 针对 Vue 文件的配置
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode" // Vue 文件的默认格式化工具设置为 Prettier
  },

  // i18n-ally 的本地化文件路径配置
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.keystyle": "nested", // i18n-ally 的键名风格为嵌套
  "i18n-ally.sortKeys": true, // 启用键名排序
  "i18n-ally.namespace": false, // 不启用命名空间
  "i18n-ally.enabledParsers": ["ts"], // 启用的解析器列表，这里支持 TypeScript
  "i18n-ally.sourceLanguage": "en", // 设置源语言为英语
  "i18n-ally.displayLanguage": "zh-CN", // 设置显示语言为简体中文
  "i18n-ally.enabledFrameworks": ["vue", "react"], // 启用的框架支持列表，这里支持 Vue 和 React

  // TypeScript 配置文件的路径
  "god.tsconfig": "./tsconfig.json"
}
